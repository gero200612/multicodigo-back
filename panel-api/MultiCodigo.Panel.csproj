<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Un warning de compilacion en este servicio es un error: es el unico
         expuesto a internet y el que administra credenciales. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Los tests necesitan ver los tipos internos sin volverlos publicos.
         Va como ITEM y no como propiedad: dentro de PropertyGroup, MSBuild lo
         acepta sin protestar y no genera nada, asi que la intencion estaba
         escrita pero no se cumplia. Se descubrio al escribir el test de
         deserializacion de PostgREST, que necesita ver `Json`. -->
    <InternalsVisibleTo Include="MultiCodigo.Panel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.AspNetCore.OpenApi salio a proposito: arrastraba
         Microsoft.OpenApi 2.0.0, que tiene una vulnerabilidad alta conocida
         (GHSA-v5pm-xwqc-g5wc), y este servicio no publica un swagger. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.3" />
  </ItemGroup>

</Project>
